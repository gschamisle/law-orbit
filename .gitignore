# Python-generated files
__pycache__/
*.py[oc]
build/
dist/
wheels/
*.egg-info

# Virtual environments
.venv

# Project-specific
node_modules/
.env
pdf_pages/
data/law-snapshots/

# 분석 산출물은 기본적으로 Git에서 제외한다.
output/*

# Local reference materials (keep on disk, not in git)
docs/*.pdf
docs/입법예고/

# 도구 상태 디렉터리 (bkit 플러그인)
.bkit/
docs/법령검색목록_법령.csv
*.pptx
presentation.html

# 수집한 입법예고 의견 원문·요약 캐시 (개인 작성 글 — 커밋 금지)
data/opinions/

# 내부자료 — 업로드된 개정안 원문·분석 산출물 (절대 커밋 금지)
data/uploads/
data/uploaded_draft.txt
data/draft_report.txt
data/golden_review_expected.json
*.hwp
*.hwpx

# 하위 폴더의 PDF도 제외한다. 기존 'docs/*.pdf'는 docs 바로 아래만 걸러서
# 'docs/세법개정 세트/*.pdf' 같은 참고자료가 새어나갔다.
docs/**/*.pdf

# Local development logs and previews
work/

# Reproducible public-law XML cache (the normalized corpus is kept separately).
data/law-galaxy-snapshots/
